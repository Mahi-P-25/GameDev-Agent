{
  "name": "nova",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nova — the AI-native operating system for game development.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:packages": "turbo run test",
    "test:watch": "vitest",
    "dev": "turbo run dev --filter=./apps/*",
    "clean": "turbo run clean && node scripts/clean.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.3",
    "@changesets/cli": "^2.27.8",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
