{
  "name": "@gamedev-agent/studio-api",
  "version": "0.1.0",
  "description": "Nova Studio API — the application façade. Every Nova frontend (Desktop, Web, CLI, VS Code) communicates only with this layer.",
  "type": "module",
  "license": "PROPRIETARY",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@gamedev-agent/capabilities": "workspace:*",
    "@gamedev-agent/context": "workspace:*",
    "@gamedev-agent/coordinator": "workspace:*",
    "@gamedev-agent/config": "workspace:*",
    "@gamedev-agent/di": "workspace:*",
    "@gamedev-agent/events": "workspace:*",
    "@gamedev-agent/execution-engine": "workspace:*",
    "@gamedev-agent/kernel": "workspace:*",
    "@gamedev-agent/terminal": "workspace:*",
    "@gamedev-agent/logging": "workspace:*",
    "@gamedev-agent/planner": "workspace:*",
    "@gamedev-agent/producer": "workspace:*",
    "@gamedev-agent/project": "workspace:*",
    "@gamedev-agent/runtime": "workspace:*",
    "@gamedev-agent/shared": "workspace:*",
    "@gamedev-agent/tool-runtime": "workspace:*",
    "@gamedev-agent/vscode": "workspace:*",
    "@gamedev-agent/workflow": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
