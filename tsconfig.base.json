{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "GameDev Agent Base",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.tsbuildinfo",
    "useDefineForClassFields": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": false,
    "baseUrl": ".",
    "paths": {
      "@gamedev-agent/shared": ["packages/shared/src/index.ts"],
      "@gamedev-agent/di": ["packages/di/src/index.ts"],
      "@gamedev-agent/config": ["packages/config/src/index.ts"],
      "@gamedev-agent/logging": ["packages/logging/src/index.ts"],
      "@gamedev-agent/events": ["packages/events/src/index.ts"],
      "@gamedev-agent/kernel": ["packages/kernel/src/index.ts"],
      "@gamedev-agent/project": ["packages/project/src/index.ts"],
      "@gamedev-agent/coordinator": ["packages/coordinator/src/index.ts"],
      "@gamedev-agent/producer": ["packages/producer/src/index.ts"],
      "@gamedev-agent/capabilities": ["packages/capabilities/src/index.ts"],
      "@gamedev-agent/tool-runtime": ["packages/tool-runtime/src/index.ts"],
      "@gamedev-agent/vscode": ["packages/vscode/src/index.ts"],
      "@gamedev-agent/workflow": ["packages/workflow/src/index.ts"],
      "@gamedev-agent/terminal": ["packages/terminal/src/index.ts"],
      "@gamedev-agent/workspace": ["packages/workspace/src/index.ts"],
      "@gamedev-agent/context": ["packages/context/src/index.ts"],
      "@gamedev-agent/intelligence": ["packages/intelligence/src/index.ts"],
      "@gamedev-agent/runtime": ["packages/runtime/src/index.ts"],
      "@gamedev-agent/memory": ["packages/memory/src/index.ts"],
      "@gamedev-agent/agent-runtime": ["packages/agent-runtime/src/index.ts"],
      "@gamedev-agent/agents": ["packages/agents/src/index.ts"],
      "@gamedev-agent/director": ["packages/director/src/index.ts"],
      "@gamedev-agent/task-graph": ["packages/task-graph/src/index.ts"],
      "@gamedev-agent/model-providers": ["packages/model-providers/src/index.ts"],
      "@gamedev-agent/execution-engine": ["packages/execution-engine/src/index.ts"],
      "@gamedev-agent/ami": ["packages/ami/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "coverage", ".turbo"]
}
