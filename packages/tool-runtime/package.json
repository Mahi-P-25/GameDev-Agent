{
  "name": "@gamedev-agent/tool-runtime",
  "version": "0.1.0",
  "description": "Nova Tool Runtime — the consistent runtime for discovering, connecting, monitoring, and invoking external tools (Git, Terminal, Browser, VS Code, Blender, …). All tool access flows through this runtime; nothing reaches a tool directly.",
  "type": "module",
  "license": "PROPRIETARY",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@gamedev-agent/capabilities": "workspace:*",
    "@gamedev-agent/coordinator": "workspace:*",
    "@gamedev-agent/di": "workspace:*",
    "@gamedev-agent/events": "workspace:*",
    "@gamedev-agent/kernel": "workspace:*",
    "@gamedev-agent/logging": "workspace:*",
    "@gamedev-agent/runtime": "workspace:*",
    "@gamedev-agent/shared": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
